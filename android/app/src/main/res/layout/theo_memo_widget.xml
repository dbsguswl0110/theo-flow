<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/memo_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/theo_widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TEO 메모 스위치" android:textColor="#684A38" android:textSize="15sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/memo_widget_note" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:text="NOTE" android:textColor="#684A38" android:textSize="11sp" android:background="@drawable/theo_widget_cell_background" />
        <TextView android:id="@+id/memo_widget_task" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="6dp" android:gravity="center" android:text="TASK" android:textColor="#684A38" android:textSize="11sp" android:background="@drawable/theo_widget_cell_background" />
        <TextView android:id="@+id/memo_widget_todo" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="6dp" android:gravity="center" android:text="TODO" android:textColor="#684A38" android:textSize="11sp" android:background="@drawable/theo_widget_cell_background" />
        <TextView android:id="@+id/memo_widget_calendar" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="6dp" android:gravity="center" android:text="달력" android:textColor="#684A38" android:textSize="11sp" android:background="@drawable/theo_widget_cell_background" />
    </LinearLayout>
</LinearLayout>
