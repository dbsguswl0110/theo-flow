<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/theo_widget_background">
<TextView android:id="@+id/widget_month" android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical" android:text="Calendar" android:textColor="#292421" android:textSize="16dp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
<LinearLayout android:id="@+id/widget_weekdays" android:layout_width="match_parent" android:layout_height="22dp" android:orientation="horizontal"/>
<LinearLayout android:id="@+id/widget_grid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"/>
<TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="14dp" android:textColor="#796B61" android:textSize="8dp" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
