<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingTop="14dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingBottom="0dp" android:background="@drawable/theo_widget_background">
    <TextView android:id="@+id/widget_month" android:layout_width="match_parent" android:layout_height="32dp"
        android:gravity="center_vertical" android:text="Calendar" android:textColor="#292421"
        android:textSize="20sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:id="@+id/widget_weekdays" android:layout_width="match_parent" android:layout_height="26dp" android:orientation="horizontal" />
    <LinearLayout android:id="@+id/widget_grid" android:layout_width="match_parent" android:layout_height="312dp"
        android:orientation="vertical" />
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="14dp"
        android:visibility="gone" android:textColor="#796B61" android:textSize="8sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
