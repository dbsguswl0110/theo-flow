{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "theo-flow",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "theo-flow", "database_id": "49e887d0-ff81-44a0-bd77-fd735e8d0b4f", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "theo-flow-photos" }]
}
